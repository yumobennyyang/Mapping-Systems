_right\">\n                \n                    立即体验\n                \n            </div></a></div><script>var DIGIT_COUNTER_CONFIG={DURATION:2e3,ROLL_COUNT:2,DELAY_BETWEEN_DIGITS:40,DIGIT_HEIGHT:20,ANIMATE_DURATION:100};var aiSearchData;try{aiSearchData=JSON.parse(document.querySelector(\"#new_search_guide_bub_aiSearch\").innerHTML||\"[]\")}catch(error){aiSearchData=[]}var aiSearch=aiSearchData[0]||{};var isLogin=aiSearchData[1];function getDate(){var now=new Date;var dateStr=\"\";dateStr+=now.getFullYear()+\"-\";dateStr+=now.getMonth()+1+\"-\";dateStr+=now.getDate()>9?now.getDate():\"0\"+now.getDate()\n;return dateStr}function isIOS155Below(){var ua=navigator.userAgent;if(/Chrome|Chromium|Edg|OPR/.test(ua)){return false}if(!/Safari\\//.test(ua)){return false}var versionMatch=ua.match(/Version\\/(\\d+)\\.(\\d+)/);if(versionMatch){var major=parseInt(versionMatch[1],10);var minor=parseInt(versionMatch[2],10);return major<15||major===15&&minor<5}var osMatch=ua.match(/OS (\\d+)_(\\d+)/);if(osMatch){var osMajor=parseInt(osMatch[1],10);var osMinor=parseInt(osMatch[2],10)\n;return osMajor<15||osMajor===15&&osMinor<5}return false}function handleStorageNumber(){if(!isLogin){var lastCountInfo=JSON.parse(localStorage.getItem(\"newSearchAiSearchCountInfo\"))||{lastCountDay:0,lastCount:0};var lastCountDay=lastCountInfo.lastCountDay;var nowTime=getDate();if(lastCountDay===nowTime){var localCount=Number(lastCountInfo.lastCount)||0;aiSearch.count=Math.max(aiSearch.count,localCount)}localStorage.setItem(\"newSearchAiSearchCountInfo\",JSON.stringify({lastCountDay:nowTime,\nlastCount:aiSearch.count}))}else{localStorage.setItem(\"newSearchAiSearchCountInfo\",'{\"lastCountDay\":0,\"lastCount\":0}')}}function showBubbleAnimation(){var guideBubble=document.querySelector(\".new_search_guide_bub\");if(!guideBubble||aiSearch.icon){return}var lastAnimationTime=localStorage.getItem(\"newSearchGuideBubbleAnimation\");var nowTime=getDate();if(lastAnimationTime===nowTime){return}var textLength=aiSearch.text&&aiSearch.text.length||10;var bubbleAnimationLength=textLength;if(\naiSearch.count||aiSearch.count>=1e4){var textLengthHasCount=aiSearch.text&&aiSearch.text.length;var countLength=aiSearch.count.toString().length||5;var prefixTextLength=aiSearch.prefixText&&aiSearch.prefixText.length||5;var suffixTextLength=aiSearch.suffixText&&aiSearch.suffixText.length||3;bubbleAnimationLength=textLengthHasCount+countLength+prefixTextLength+suffixTextLength}var containerCenter=document.querySelector(\".new_search_guide_bub_container_center\");if(containerCenter){\nbubbleAnimationLength=bubbleAnimationLength+3;containerCenter.style.setProperty(\"--bubble-animation-length\",\"-\"+bubbleAnimationLength+\"em\")}if(guideBubble.classList){guideBubble.classList.add(\"new_search_guide_bub_animation\")}else{var className=guideBubble.className;if(className.indexOf(\"new_search_guide_bub_animation\")===-1){guideBubble.className=className+\" new_search_guide_bub_animation\"}}localStorage.setItem(\"newSearchGuideBubbleAnimation\",nowTime)}function getNumberCounter(){\nfunction DigitCounter(options){options=options||{};this.options={digitCount:options.digitCount||5,duration:options.duration||DIGIT_COUNTER_CONFIG.DURATION,easing:options.easing||\"ease-in-out\",delayBetweenDigits:options.delayBetweenDigits||DIGIT_COUNTER_CONFIG.DELAY_BETWEEN_DIGITS,rollCount:options.rollCount||DIGIT_COUNTER_CONFIG.ROLL_COUNT};this.counter=document.querySelector(\".new_search_guide_bub_container_center_number_counter\");if(this.counter){this.init()}else{showBubbleAnimation()}}\nDigitCounter.prototype.animate=function(targetNumber){if(!this.counter){return}var digits=targetNumber.toString().split(\"\");var digitLists=document.querySelectorAll(\".new_search_guide_bub_container_center_number_counter_digit_container_digit_list\");for(var i=0;i<digitLists.length;i++){var list=digitLists[i];var digitList=list;var isFirefox=navigator.userAgent.toLowerCase().indexOf(\"firefox\")>-1;if(!isFirefox){digitList.style.background=\"#000000\";digitList.style.color=\"transparent\"\n;digitList.style.backgroundClip=\"text\";digitList.style.webkitBackgroundClip=\"text\"}var targetDigit=parseInt(digits[i],10);var extraRolls=this.options.rollCount*10;var targetY=-(extraRolls+targetDigit)*DIGIT_COUNTER_CONFIG.DIGIT_HEIGHT;digitList.style.transform=\"translateY(\"+targetY+\"px)\"}setTimeout(function(){var counter=document.querySelector(\".new_search_guide_bub_container_center_number_counter\");if(counter){var digits=targetNumber.toString().split(\"\");var html=\"\";for(\nvar i=0;i<digits.length;i++){html+=\"<span>\"+digits[i]+\"</span>\"}counter.innerHTML=html}showBubbleAnimation()}.bind(this),DIGIT_COUNTER_CONFIG.DURATION)};DigitCounter.prototype.init=function(){if(!this.counter){return}var length=this.options.digitCount;var html=\"\";for(var i=0;i<this.options.digitCount;i++){var singleSequence=[];for(var j=0;j<10;j++){singleSequence.push(j)}var repeatedSequence=[];for(var k=0;k<=this.options.rollCount;k++){repeatedSequence=repeatedSequence.concat(singleSequence)}\nvar digitHtml='<div class=\"new_search_guide_bub_container_center_number_counter_digit_container\">'+'<div class=\"new_search_guide_bub_container_center_number_counter_digit_container_digit_list\" '+'style=\"--duration: '+(this.options.duration-(length-i)*this.options.delayBetweenDigits)+\"ms; --easing: \"+this.options.easing+';\">';for(var m=0;m<repeatedSequence.length;m++){digitHtml+='<span class=\"digit\">'+repeatedSequence[m]+\"</span>\"}digitHtml+=\"</div></div>\";html+=digitHtml}\nthis.counter.innerHTML=html};var digitCount=0;var textContainer=document.querySelector(\".new_search_guide_bub_container_center\");if(isIOS155Below()&&textContainer){if(aiSearch.count){textContainer.innerText=\"即刻体验 AI搜索DeepSeek-R1满血版\"}textContainer.style.display=\"block\";return}if(aiSearch.count){handleStorageNumber();digitCount=aiSearch.count.toString().length}var counter=new DigitCounter({digitCount:digitCount});setTimeout(function(){counter.animate(aiSearch.count||0)},\nDIGIT_COUNTER_CONFIG.ANIMATE_DURATION)}function showNewSearcGuideBubbleAnimation(){var guideBubble=document.querySelector(\".new_search_guide_bub\");if(!guideBubble){return}getNumberCounter()}function checkElementsAndExecute(){var guideBubble=document.querySelector(\".new_search_guide_bub\");var aiSearchScript=document.querySelector(\"#new_search_guide_bub_aiSearch\");if(!guideBubble||!aiSearchScript){return false}showNewSearcGuideBubbleAnimation();return true}if(!checkElementsAndExecute()){if(\ntypeof MutationObserver!==\"undefined\"){var observer=new MutationObserver(function(mutations){if(checkElementsAndExecute()){observer.disconnect()}});observer.observe(document.body,{childList:true,subtree:true})}else{var checkInterval=setInterval(function(){if(checkElementsAndExecute()){clearInterval(checkInterval)}},100)}}</script></div><div id=\"m\" class=\"\n                    under-searchbox-tips\n                    \n                        s_lm_hide\n                    \n                \"><div id=\"lm-new\"></div></div><div id=\"s-hotsearch-wrapper\" class=\"s-isindex-wrap s-hotsearch-wrapper   s-hotsearch-wrapper-no-login  hide have-search-guide\"><div class=\"s-hotsearch-title\"><a class=\"hot-title\" href=\"https://top.baidu.com/board?platform=pc&sa=pcindex_entry\" target=\"_blank\"><div class=\"title-text c-font-medium c-color-t\" aria-label=\"百度热搜\"><i class=\"c-icon hot-title-icon\">&#xe687;</i><i class=\"c-icon arrow\">&#xe613;</i></div></a><a id=\"hotsearch-refresh-btn\" class=\"hot-refresh c-font-normal c-color-gray2\"><i class=\"c-icon refresh-icon\">&#xe619;</i><span class=\"hot-refresh-text\">换一换</span></a></div><ul class=\"s-hotsearch-content\" id=\"hotsearch-content-wrapper\"><li class=\"hotsearch-item odd\" data-index=\"0\"><a class=\"title-content  c-link c-font-medium c-line-clamp1\" href=\"https://www.baidu.com/s?wd=%E4%B8%AD%E6%AC%A7%E9%A2%86%E5%AF%BC%E4%BA%BA%E8%A6%81%E4%BD%9C%E6%AD%A3%E7%A1%AE%E6%88%98%E7%